# Copy to .env and fill in. Never commit the real .env.
# TODO(mvp, milestone 2+): these are the keys later milestones will need; nothing here
# is consumed yet by milestone 1 (models/renderer/VaultWriter have no config dependency).

# LLM
LLM_PROVIDER=bedrock          # bedrock | anthropic
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=            # only used when LLM_PROVIDER=anthropic (local dev fallback)

# Vault
VAULT_PATH=./vault

# Redshift (analyst tool, read-only)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
