# Copy to .env and fill in. Never commit the real .env.

# LLM
LLM_PROVIDER=bedrock          # bedrock | anthropic
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=            # only used when LLM_PROVIDER=anthropic (local dev fallback)

# CrewAI: no interactive prompts, no telemetry — see crewai/events/listeners/tracing/utils.py
CREWAI_TESTING=true
CREWAI_TRACING_ENABLED=false

# Vault
VAULT_PATH=./vault

# Redshift (analyst tool, read-only)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
