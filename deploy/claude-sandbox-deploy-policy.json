{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2Read",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2Write",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamForInstanceRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRole",
        "iam:GetInstanceProfile",
        "iam:PassRole",
        "iam:TagRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerExistenceCheckOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": "*"
    },
    {
      "Sid": "SsmReadOnly",
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*"
    },
    {
      "Sid": "SsmSendCommand",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:eu-west-1:873540496383:instance/i-0405a7fb0877838ab",
        "arn:aws:ssm:eu-west-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "SsmGetCommandInvocation",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    },
    {
      "Sid": "SsmStartSession",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:eu-west-1:873540496383:instance/i-0405a7fb0877838ab",
        "arn:aws:ssm:eu-west-1::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "SsmTerminateOwnSession",
      "Effect": "Allow",
      "Action": "ssm:TerminateSession",
      "Resource": "arn:aws:ssm:eu-west-1:873540496383:session/${aws:username}-*"
    }
  ]
}
